# Copy this file to .env and fill it in. Everything is optional except the
# email settings, which are needed for email alerts.

# The login password, as a hash. Create the line with
#   node scripts/hash-password.js
# and paste it over this one. Without it the login is off, which the app only
# allows while HOST is 127.0.0.1.
AUTH_PASSWORD_HASH=

# Where the app listens. Keep 127.0.0.1 when a reverse proxy or Tailscale sits
# in front. Any other address needs AUTH_PASSWORD_HASH, or the app will not start.
HOST=127.0.0.1
PORT=3000

# Set to 1 only when a reverse proxy sits in front of the app, so that failed
# logins are counted per visitor instead of all against the proxy.
TRUST_PROXY=

# Email alerts, sent through Resend (https://resend.com, free tier is enough).
# Use a key with full access: a "sending access" key can send, but the app
# cannot then confirm whether an email was delivered or bounced.
RESEND_API_KEY=
# Where alerts go. Can also be changed in the app's alert settings.
ALERT_EMAIL_TO=
# Must be an address on a domain you have verified in Resend. Until then,
# onboarding@resend.dev works but only delivers to your own Resend login email.
ALERT_EMAIL_FROM=SSL Tracker <onboarding@resend.dev>

# The address you open the app at, e.g. https://tracker.your-tailnet.ts.net.
# Used for the link in alerts, and it is the one address besides this machine
# itself (localhost, 127.0.0.1) that the app answers to.
PUBLIC_URL=

# Other names or IP addresses the app may be opened at, comma separated, e.g.
# 192.168.1.20,nas.lan. Requests for any other address are refused (403).
ALLOWED_HOSTS=

# Contact address sent to browser push services. Defaults to mailto:ALERT_EMAIL_TO.
VAPID_SUBJECT=

# Where the database and push keys are kept (relative to this folder). Daily
# snapshots of both go in its backups/ subfolder.
DATA_DIR=data

# How often every domain is re-checked.
CHECK_INTERVAL_HOURS=24

# Dead-man's switch. After every completed scheduler run (hourly) the app sends
# one GET request here. Point it at a check on an outside service such as
# https://healthchecks.io (free), set to expect a ping every hour, and that
# service emails you when the pings stop: machine off, app crashed, no network.
# Leave empty to turn it off.
HEARTBEAT_URL=
